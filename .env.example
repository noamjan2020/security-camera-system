# Shared backend configuration. Never commit real values.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=
FCM_PROJECT_ID=

# Signaling server. Use WSS in production. Native clients do not require an Origin header.
PORT=8787
ALLOWED_ORIGIN=
SIGNALING_URL=wss://signal.example.com

# Optional STUN/TURN values used by the create-stream Edge Function.
# Comma-separated URL lists are supported.
STUN_URLS=stun:stun.example.com:3478
TURN_URLS=turns:turn.example.com:5349?transport=tcp
TURN_SHARED_SECRET=

# Android build-time public client configuration.
HOMEGUARD_SUPABASE_URL=
HOMEGUARD_SUPABASE_ANON_KEY=

# Android release signing. Keep these in local/CI secret storage.
HOMEGUARD_ANDROID_KEYSTORE_PATH=
HOMEGUARD_ANDROID_KEYSTORE_PASSWORD=
HOMEGUARD_ANDROID_KEY_ALIAS=
HOMEGUARD_ANDROID_KEY_PASSWORD=
