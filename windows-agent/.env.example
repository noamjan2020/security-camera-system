# Storage and camera
HOMEGUARD_DATA_DIR=./data
HOMEGUARD_CAMERA_INDEX=0
HOMEGUARD_CAMERA_NAME=Main Camera
HOMEGUARD_CAMERA_WIDTH=1280
HOMEGUARD_CAMERA_HEIGHT=720
HOMEGUARD_MAX_FPS=12
HOMEGUARD_JPEG_QUALITY=86

# Local authenticated API and QR pairing
HOMEGUARD_API_HOST=0.0.0.0
HOMEGUARD_API_PORT=8765
HOMEGUARD_PAIRING_BASE_URL=
HOMEGUARD_PAIRING_CODE_TTL_SECONDS=120
HOMEGUARD_API_TOKEN=

# Detection performance
HOMEGUARD_DETECTOR_BACKEND=auto
HOMEGUARD_DETECTOR_MODEL_PATH=./models/yolo11n.onnx
HOMEGUARD_DETECTION_CONFIDENCE=0.55
HOMEGUARD_NMS_THRESHOLD=0.45
HOMEGUARD_INFERENCE_SIZE=640
HOMEGUARD_INFERENCE_FPS=4
HOMEGUARD_VISIBLE_SECONDS=1.5
HOMEGUARD_COOLDOWN_SECONDS=60
# Normalized [x,y,width,height]. JSON syntax is required in environment variables.
HOMEGUARD_DETECTION_ZONE=[0.0,0.0,1.0,1.0]
HOMEGUARD_EXCLUSION_ZONES=[]

# Local face whitelist
HOMEGUARD_FACE_WHITELIST_ENABLED=true
HOMEGUARD_FACE_DETECTOR_MODEL_PATH=./models/face_detection_yunet_2023mar.onnx
HOMEGUARD_FACE_RECOGNIZER_MODEL_PATH=./models/face_recognition_sface_2021dec.onnx
HOMEGUARD_FACE_DETECTION_CONFIDENCE=0.90
HOMEGUARD_FACE_MATCH_THRESHOLD=0.50
HOMEGUARD_RECORD_WHITELISTED_EVENTS=true

# Retention and health
HOMEGUARD_RETENTION_MINUTES=60
HOMEGUARD_CLEANUP_INTERVAL_SECONDS=300
HOMEGUARD_DISK_WARNING_MB=512

# Optional secure remote mode. Use an owner Supabase session, never a service-role key.
HOMEGUARD_REMOTE_ENABLED=false
HOMEGUARD_SUPABASE_URL=
HOMEGUARD_SUPABASE_ANON_KEY=
HOMEGUARD_SUPABASE_ACCESS_TOKEN=
HOMEGUARD_OWNER_ID=
HOMEGUARD_DEVICE_ID=
HOMEGUARD_CAMERA_ID=
HOMEGUARD_NOTIFY_FUNCTION_URL=
HOMEGUARD_CLOUD_TIMEOUT_SECONDS=15
HOMEGUARD_UPLOAD_RETRY_BASE_SECONDS=5
HOMEGUARD_UPLOAD_RETRY_MAX_SECONDS=300

# Optional WebRTC. The heavy dependencies load only while remote Live View is active.
HOMEGUARD_WEBRTC_ENABLED=true
HOMEGUARD_WEBRTC_MAX_FPS=15
HOMEGUARD_WEBRTC_MAX_WIDTH=1280
HOMEGUARD_WEBRTC_MAX_HEIGHT=720
HOMEGUARD_WEBRTC_MAX_SESSION_SECONDS=330

# Voice limits and diagnostics
HOMEGUARD_AUDIO_MAX_BYTES=5000000
HOMEGUARD_AUDIO_MAX_SECONDS=30
HOMEGUARD_DEBUG=false
